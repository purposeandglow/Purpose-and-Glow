# Gemini API Key for Server-Side AI (Copilot, Live Qualification, & Gated Public Feedback)
GEMINI_API_KEY=

# Verified Production Gemini Model Identifiers (Phase 1+ Verified Config)
# Override after running model verification against your active GEMINI_API_KEY
GEMINI_PUBLIC_MODEL=gemini-3.1-flash-lite
GEMINI_ADMIN_MODEL=gemini-3.1-flash-lite

# Public AI Feature Gate (MUST remain false until privacy/tier disclosures are approved)
PUBLIC_AI_ENABLED=false

# Enforceable Public AI Rate Limits & Circuit Breakers
PUBLIC_AI_HOURLY_IP_LIMIT=3
PUBLIC_AI_DAILY_IP_LIMIT=5
PUBLIC_AI_DAILY_LIMIT=100
PUBLIC_AI_MONTHLY_LIMIT=2000
# Supported values: "memory" (dev/pre-launch while PUBLIC_AI_ENABLED=false) or "firestore" (production launch via Cloud Run/App Hosting ADC)
RATE_LIMIT_BACKEND=memory
TRUST_PROXY_HOPS=1
# Production-only secret (optional while PUBLIC_AI_ENABLED=false; uncomment and generate 32 random hex bytes before enabling public AI):
# RATE_LIMIT_SALT=

# Admin Security Allowlist (Verified Google Sign-In Required)
ADMIN_EMAIL=purposeandglowcareers@gmail.com

# Purpose & Glow Business Email
BUSINESS_EMAIL=purposeandglowcareers@gmail.com

# Cloudflare Turnstile Bot Protection (Optional while PUBLIC_AI_ENABLED=false; uncomment & fill before setting PUBLIC_AI_ENABLED=true in production)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# External Email Dispatch Services (Resend Free Tier: 3,000/mo, 100/day)
# Create API key in Resend, verify your sending domain (e.g. purposeglowcareer.com), and set both before activating emails:
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@purposeglowcareer.com
# Optional override ("firestore" uses Firebase Admin SDK on /inquiries; automatic in production/Cloud Run):
# INQUIRIES_STORAGE_BACKEND=memory

# Legacy Cloud SQL PostgreSQL Configuration (Optional - retained read-only for backup/migration)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# Port Configuration
PORT=3000
