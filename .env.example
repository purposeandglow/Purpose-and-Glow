# Gemini API Key for Copilot & AI Diagnostic Qualification
GEMINI_API_KEY=

# Cloud SQL PostgreSQL Configuration (Optional - in-memory fallback active if unset)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# Port Configuration
PORT=3000

# Purpose & Glow Business Email
BUSINESS_EMAIL=purposeandglowcareers@gmail.com

